<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Self-hosted Codex Web installations commonly run on a trusted LAN over HTTP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
